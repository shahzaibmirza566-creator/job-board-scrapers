# Copy to .env and fill in. .env is git-ignored - never commit real values.

# Optional: route requests through ScrapingBee (leave empty for plain Scrapy requests)
SCRAPINGBEE_API_KEY=

# Optional: route requests through Zyte Smart Proxy Manager (leave empty to disable)
ZYTE_SMARTPROXY_APIKEY=

# Required for the Monster spider: the public key Monster's web client sends with
# its search requests (copy it from your browser's network tab).
MONSTER_API_KEY=

# Where scraped jobs are stored
DB_PATH=data/jobs.db

# Politeness / limits (defaults shown)
ROBOTSTXT_OBEY=true
CONCURRENT_REQUESTS=6
DOWNLOAD_DELAY=0.5
MAX_PAGES=20
MAX_KNOWN_JOBS_PER_QUERY=80
